#!/usr/bin/env python3

from action_msgs.msg import GoalStatus
from geometry_msgs.msg import PoseStamped
from lifecycle_msgs.msg import State
from lifecycle_msgs.srv import GetState
from nav2_msgs.action import ComputePathToPose
from nav_msgs.msg import Path
import rclpy
from rclpy.action import ActionClient
from rclpy.executors import ExternalShutdownException
from rclpy.node import Node
from rclpy.qos import DurabilityPolicy, QoSProfile


class GoalPoseBridge(Node):
    def __init__(self):
        super().__init__("goal_pose_bridge")
        self._planner = ActionClient(self, ComputePathToPose, "compute_path_to_pose")
        self._planner_state = self.create_client(GetState, "planner_server/get_state")
        self._path_pub = self.create_publisher(
            Path, "plan", QoSProfile(depth=1, durability=DurabilityPolicy.TRANSIENT_LOCAL)
        )
        self._goal_sub = self.create_subscription(PoseStamped, "goal_pose", self._receive_goal, 1)
        self._pending_goal = None
        self._state_future = None
        self._goal_number = 0
        self._timer = self.create_timer(0.2, self._try_plan)

    def _receive_goal(self, pose):
        self._goal_number += 1
        self._pending_goal = pose
        self._path_pub.publish(Path(header=pose.header))

    def _try_plan(self):
        if self._pending_goal is None or self._state_future is not None:
            return
        if self._planner.server_is_ready() and self._planner_state.service_is_ready():
            self._state_future = self._planner_state.call_async(GetState.Request())
            self._state_future.add_done_callback(self._plan_if_active)

    def _plan_if_active(self, future):
        self._state_future = None
        try:
            active = future.result().current_state.id == State.PRIMARY_STATE_ACTIVE
        except Exception as error:
            self.get_logger().warning(f"Cannot read planner state: {error}")
            return
        if not active:
            return
        goal = ComputePathToPose.Goal(goal=self._pending_goal, planner_id="GridBased", use_start=False)
        self._pending_goal = None
        goal_number = self._goal_number
        self._planner.send_goal_async(goal).add_done_callback(
            lambda response: self._wait_for_result(response, goal_number)
        )

    def _wait_for_result(self, future, goal_number):
        try:
            handle = future.result()
            if handle.accepted:
                handle.get_result_async().add_done_callback(
                    lambda result: self._publish_result(result, goal_number)
                )
            elif goal_number == self._goal_number:
                self.get_logger().error("Nav2 rejected the planning goal.")
        except Exception as error:
            self.get_logger().error(f"Could not send the planning goal: {error}")

    def _publish_result(self, future, goal_number):
        if goal_number != self._goal_number:
            return
        try:
            response = future.result()
            if response.status == GoalStatus.STATUS_SUCCEEDED and response.result.path.poses:
                self._path_pub.publish(response.result.path)
            else:
                detail = response.result.error_msg or f"action status {response.status}"
                self.get_logger().error(f"Nav2 could not compute a path: {detail}")
        except Exception as error:
            self.get_logger().error(f"Could not read the Nav2 path: {error}")


def main():
    rclpy.init()
    node = GoalPoseBridge()
    try:
        rclpy.spin(node)
    except (KeyboardInterrupt, ExternalShutdownException):
        pass
    finally:
        node.destroy_node()
        rclpy.try_shutdown()


if __name__ == "__main__":
    main()
